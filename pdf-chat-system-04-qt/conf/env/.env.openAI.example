# Example OpenAI configuration.
# 1) Copy this file's api_key line into conf/env/.env.local and set your key.
# 2) Non-secret settings (model/temperature/tokens) live in conf/env/.env.openAI.
#
# .env.local takes priority over .env.openAI.

api_key=sk-REPLACE_WITH_YOUR_KEY
model=gpt-4.1-mini
llm_temperature=0.2
llm_max_tokens=1000