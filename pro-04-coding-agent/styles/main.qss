/* ── Global ─────────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralWidget {
    background-color: #1a1a2e;
    color: #e0e0e0;
    font-family: "Consolas", "Menlo", "Courier New", monospace;
    font-size: 13px;
}

/* ── Toolbar ─────────────────────────────────────────────────────────────── */
QWidget#toolbar {
    background-color: #16213e;
    border-bottom: 1px solid #0f3460;
    min-height: 48px;
}

QLabel#toolbarTitle {
    color: #e94560;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#clearButton {
    background-color: transparent;
    color: #888;
    border: 1px solid #333;
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 12px;
}

QPushButton#clearButton:hover {
    border-color: #e94560;
    color: #e94560;
}

QPushButton#clearButton:disabled {
    color: #444;
    border-color: #2a2a2a;
}

/* ── Chat area ───────────────────────────────────────────────────────────── */
QWidget#chatArea {
    background-color: #1a1a2e;
}

QScrollArea#chatScroll {
    background-color: #1a1a2e;
    border: none;
}

QWidget#chatContainer {
    background-color: #1a1a2e;
}

/* ── Message bubbles ─────────────────────────────────────────────────────── */
QLabel#userBubble {
    background-color: #0f3460;
    color: #e0e0e0;
    border-radius: 12px;
    padding: 10px 14px;
    max-width: 520px;
    line-height: 1.5;
}

QLabel#assistantBubble {
    background-color: #16213e;
    color: #c8d8e8;
    border-radius: 12px;
    border: 1px solid #0f3460;
    padding: 10px 14px;
    max-width: 580px;
    line-height: 1.5;
}

/* ── Placeholder ─────────────────────────────────────────────────────────── */
QWidget#placeholder {
    background-color: #1a1a2e;
}

QLabel#placeholderIcon {
    font-size: 40px;
    color: #333;
}

QLabel#placeholderHint {
    color: #444;
    font-size: 13px;
}

/* ── Input bar ───────────────────────────────────────────────────────────── */
QWidget#inputBar {
    background-color: #16213e;
    border-top: 1px solid #0f3460;
}

QTextEdit#textInput {
    background-color: #1a1a2e;
    color: #e0e0e0;
    border: 1px solid #0f3460;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas", "Menlo", "Courier New", monospace;
    font-size: 13px;
    selection-background-color: #e94560;
}

QTextEdit#textInput:focus {
    border-color: #e94560;
}

QPushButton#sendButton {
    background-color: #e94560;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    min-width: 70px;
    min-height: 40px;
}

QPushButton#sendButton:hover {
    background-color: #c73652;
}

QPushButton#sendButton:disabled {
    background-color: #3a2030;
    color: #666;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
QWidget#statusBar {
    background-color: #2d1a1a;
    border-top: 1px solid #7a2020;
}

QLabel#statusMessage {
    color: #ff6b6b;
    font-size: 12px;
}

QPushButton#statusDismiss {
    background-color: transparent;
    color: #ff6b6b;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#statusDismiss:hover {
    color: #fff;
}

/* ── Scrollbar ───────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #1a1a2e;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #0f3460;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
