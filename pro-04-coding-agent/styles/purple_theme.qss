/* ── Global ─────────────────────────────────────────────────────────────── */
QMainWindow, QWidget#centralWidget {
    background-color: #f5f1ff;
    color: #2a2340;
    font-family: "Consolas", "Menlo", "Courier New", monospace;
    font-size: 13px;
}

/* ── Toolbar ─────────────────────────────────────────────────────────────── */
QWidget#toolbar {
    background-color: #e6ddff;
    border-bottom: 1px solid #c4b4f0;
    min-height: 48px;
}

QLabel#toolbarTitle {
    color: #8b6fd6;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
}

QPushButton#clearButton {
    background-color: transparent;
    color: #736a91;
    border: 1px solid #c4b4f0;
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 12px;
}

QPushButton#clearButton:hover {
    border-color: #8b6fd6;
    color: #8b6fd6;
}

QPushButton#clearButton:disabled {
    color: #736a91;
    border-color: #c4b4f0;
}

QPushButton#loadProjectButton {
    background-color: #8b6fd6;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 14px;
    font-size: 12px;
}

QPushButton#loadProjectButton:hover {
    background-color: #7558c2;
}

QPushButton#loadProjectButton:disabled {
    background-color: #b8a6e3;
    color: #f5f1ff;
}

QComboBox#modeCombo {
    background-color: #fcfaff;
    color: #2a2340;
    border: 1px solid #c4b4f0;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 12px;
    min-width: 80px;
}

QComboBox#modeCombo:hover {
    border-color: #8b6fd6;
}

QComboBox#modeCombo:disabled {
    background-color: #e6ddff;
    color: #736a91;
    border-color: #c4b4f0;
}

QComboBox#modeCombo::drop-down {
    border: none;
    width: 20px;
}

QComboBox#modeCombo QAbstractItemView {
    background-color: #fcfaff;
    color: #2a2340;
    border: 1px solid #c4b4f0;
    selection-background-color: #8b6fd6;
    selection-color: #ffffff;
}

/* ── Chat area ───────────────────────────────────────────────────────────── */
QWidget#chatArea {
    background-color: #f5f1ff;
}

QScrollArea#chatScroll {
    background-color: #f5f1ff;
    border: none;
}

QWidget#chatContainer {
    background-color: #f5f1ff;
}

/* ── Message bubbles ─────────────────────────────────────────────────────── */
QLabel#userBubble {
    background-color: #8b6fd6;
    color: #ffffff;
    border-radius: 12px;
    padding: 10px 14px;
    max-width: 520px;
    line-height: 1.5;
}

QLabel#assistantBubble {
    background-color: #e6ddff;
    color: #2a2340;
    border-radius: 12px;
    border: 1px solid #c4b4f0;
    padding: 10px 14px;
    max-width: 580px;
    line-height: 1.5;
}

/* ── Placeholder ─────────────────────────────────────────────────────────── */
QWidget#placeholder {
    background-color: #f5f1ff;
}

QLabel#placeholderIcon {
    font-size: 40px;
    color: #c4b4f0;
}

QLabel#placeholderHint {
    color: #736a91;
    font-size: 13px;
}

/* ── Input bar ───────────────────────────────────────────────────────────── */
QWidget#inputBar {
    background-color: #e6ddff;
    border-top: 1px solid #c4b4f0;
}

QTextEdit#textInput {
    background-color: #fcfaff;
    color: #2a2340;
    border: 1px solid #c4b4f0;
    border-radius: 8px;
    padding: 8px;
    font-family: "Consolas", "Menlo", "Courier New", monospace;
    font-size: 13px;
    selection-background-color: #8b6fd6;
}

QTextEdit#textInput:focus {
    border-color: #8b6fd6;
}

QPushButton#sendButton {
    background-color: #8b6fd6;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 13px;
    font-weight: bold;
    min-width: 70px;
    min-height: 40px;
}

QPushButton#sendButton:hover {
    background-color: #7558c2;
}

QPushButton#sendButton:disabled {
    background-color: #c4b4f0;
    color: #736a91;
}

/* ── Status bar ──────────────────────────────────────────────────────────── */
QWidget#statusBar {
    background-color: #e6ddff;
    border-top: 1px solid #c4b4f0;
}

QLabel#statusMessage {
    color: #736a91;
    font-size: 12px;
}

QPushButton#statusDismiss {
    background-color: transparent;
    color: #736a91;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#statusDismiss:hover {
    color: #8b6fd6;
}

/* ── Scrollbar ───────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #f5f1ff;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #b8a6e3;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
